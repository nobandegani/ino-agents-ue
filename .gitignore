# ---------------------------------------------------------------------------
# Unreal build output
# ---------------------------------------------------------------------------
# Runtime binaries for this plugin are produced by UBT per-target and are not
# committed. Native third-party runtimes (LiteRT / LiteRT-LM) are staged and
# packaged by the sibling InoLiteRT plugin, not from here.
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# ---------------------------------------------------------------------------
# Local model files
# ---------------------------------------------------------------------------
# Model bundles are gigabytes and are never committed. At runtime they are
# downloaded on demand to FPaths::ProjectPersistentDownloadDir(). This entry
# covers the legacy developer drop location (Plugins/InoAgents/Models/).
Models/
*.litertlm
*.tflite

# ---------------------------------------------------------------------------
# IDE / editor / per-developer tool state
# ---------------------------------------------------------------------------
.vs/
.idea/
*.sln
*.suo
*.VC.db
*.opensdf
*.sdf

# Claude Code per-developer permission grants — machine-specific local paths,
# intentionally not shared.
.claude/settings.local.json

# JetBrains module/workspace files (the .idea/ rule above misses these when a
# tool writes them outside .idea/).
*.iml
*.iws

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Python caches — the NeuTTS voice-encoder scripts are run in-place.
__pycache__/
*.py[cod]
.venv/
venv/
